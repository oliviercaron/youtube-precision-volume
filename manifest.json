{
  "manifest_version": 3,
  "name": "YouTube Precision Volume",
  "version": "1.0.0",
  "description": "Fine-grained volume control for YouTube videos, down to 0.01%.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "YouTube Precision Volume",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
